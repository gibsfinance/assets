[Unit]
Description=gib.show: database backup every 72 hours

[Timer]
# Every third day at 03:30 box time. Days 1,4,...,28 keep the gap at 72 hours
# except across a month end, where it is 72-120 hours.
OnCalendar=*-*-01,04,07,10,13,16,19,22,25,28 03:30:00
RandomizedDelaySec=15m
# Run a missed backup at the next start, e.g. after the user manager restarted.
Persistent=true

[Install]
WantedBy=timers.target
