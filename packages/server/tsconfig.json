{
  "extends": "../../tsconfig.json",
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/db/migrations", "src/db/config.ts", "src/db/utils.ts", "src/db/seeds"],
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "jsx": "preserve",
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
