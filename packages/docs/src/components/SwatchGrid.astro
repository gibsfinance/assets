---
/**
 * A grid of colour swatches for the design language page. Each swatch shows the colour, the name
 * of its token in `packages/ui/src/app.css` and its value. A translucent colour is drawn over a
 * checkerboard so the transparency is visible.
 */

/** One colour to show. */
interface Swatch {
  /** The token name, for example `--color-accent-500`. */
  token: string
  /** Any CSS colour value, written exactly as the token holds it. */
  value: string
  /** What the colour is for, in a few words. */
  usage?: string
}

type Props = {
  swatches: readonly Swatch[]
}

const { swatches } = Astro.props
---

<ul class="swatch-grid">
  {
    swatches.map((swatch) => (
      <li class="swatch">
        <span class="chip" role="img" aria-label={`Colour ${swatch.value}`}>
          <span class="fill" style={`background:${swatch.value}`} />
        </span>
        <span class="text">
          <code class="token">{swatch.token}</code>
          <code class="value">{swatch.value}</code>
          {swatch.usage && <span class="usage">{swatch.usage}</span>}
        </span>
      </li>
    ))
  }
</ul>

<style>
  .swatch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: 0.75rem;
    padding: 0;
    margin: 1rem 0;
    list-style: none;
  }
  .swatch {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin: 0;
    padding: 0.625rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.5rem;
    background: var(--sl-color-bg-nav);
  }
  .chip {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    overflow: hidden;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.375rem;
    background:
      conic-gradient(#8884 25%, transparent 0 50%, #8884 0 75%, transparent 0) 0 0 / 0.75rem 0.75rem;
  }
  .fill {
    display: block;
    width: 100%;
    height: 100%;
  }
  .text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    gap: 0.125rem;
  }
  code {
    padding: 0;
    background: none;
    border: 0;
    overflow-wrap: anywhere;
  }
  .token {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-white);
  }
  .value {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
  }
  .usage {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
</style>
