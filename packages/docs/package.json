{
  "name": "docs",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "The gib.show documentation site, built with Starlight.",
  "scripts": {
    "dev": "yarn run generate:openapi && astro dev",
    "generate:openapi": "node scripts/generate-openapi.ts",
    "generate:guides": "node scripts/generate-guides.ts",
    "build": "yarn run generate:openapi && astro build && yarn run generate:guides",
    "preview": "astro preview",
    "check": "node ../../scripts/tsc7.mjs --noEmit -p tsconfig.json",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.10",
    "astro": "7.4.11",
    "starlight-llms-txt": "0.12.0",
    "starlight-openapi": "0.27.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.5"
  }
}
